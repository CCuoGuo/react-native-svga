{
  "name": "@react-native-ohos/react-native-svga",
  "displayName": "react-native-svga",
  "version": "1.0.9-rc.1",
  "description": "react-native 中使用 SVGA",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "react-native": "./src/index.tsx",
  "types": "./dist/typescript/index.d.ts",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smallworld-P/react-native-svga.git",
    "baseUrl": "https://github.com/Smallworld-P/react-native-svga"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos"
  ],
  "homepage": "https://github.com/Smallworld-P/react-native-svga",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "src/",
    "harmony/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc --noEmit && bob build",
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/svga/src/main/cpp/generated --ets-output-path ./harmony/svga/src/main/ets/generated"
  },
  "peerDependencies": {
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "typescript": "5.0.4",
    "@react-native/typescript-config": "0.79.5",
    "react": "18.2.0",
    "@types/react": "18.2.79",
    "react-native": "0.72.5",
    "jest": "^29.6.3",
    "react-native-builder-bob": "^0.18.0",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  },
  "harmony": {
    "alias": "react-native-svga",
    "autolinking": {
      "cmakeLibraryTargetName": "svga",
      "ohPackageName": "@react-native-ohos/react-native-svga",
      "etsPackageClassName": "SvgaPackage",
      "cppPackageClassName": "SvgaPackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "dist",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
